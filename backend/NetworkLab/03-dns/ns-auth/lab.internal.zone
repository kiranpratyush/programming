$ORIGIN lab.internal.
$TTL 3600

@   IN SOA ns-auth.lab.internal. pratyush.gmail.com. (
        2026101701 ; serial
        3600       ; refresh
        900        ; retry
        604800     ; expire
        300 )      ; negative cache TTL

@           IN NS  ns-auth.lab.internal.

; DNS subnet
ns-auth     IN A   10.10.0.114
ns-res      IN A   10.10.0.115
ns-auth-b   IN A   10.10.0.116

; hosts
ha1         IN A   10.10.0.2
ha2         IN A   10.10.0.3
hb1         IN A   10.10.0.66
hb2         IN A   10.10.0.67
web         IN CNAME hb1

; delegation of b.lab.internal to ns-auth-b (NS + glue)
b           IN NS  ns-auth-b.b.lab.internal.
ns-auth-b.b IN A   10.10.0.116
